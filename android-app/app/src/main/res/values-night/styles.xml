<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StatisticsLover" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#0B1020</item>
        <item name="android:statusBarColor">#0B1020</item>
        <item name="android:navigationBarColor">#0B1020</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorAccent">#FF5397</item>
    </style>

    <style name="Theme.StatisticsLover.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1020</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.StatisticsLover</item>
    </style>
</resources>
