<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StatisticsLover" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#F7F8FB</item>
        <item name="android:statusBarColor">#08111F</item>
        <item name="android:navigationBarColor">#08111F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorAccent">#C6005A</item>
    </style>

    <style name="Theme.StatisticsLover.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F8FB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/Theme.StatisticsLover</item>
    </style>
</resources>
