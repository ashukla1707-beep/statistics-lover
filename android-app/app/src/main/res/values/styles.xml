<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StatisticsLover" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#F7F8FB</item>
        <item name="android:statusBarColor">#F7F8FB</item>
        <item name="android:navigationBarColor">#F7F8FB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">#C6005A</item>
    </style>

    <style name="Theme.StatisticsLover.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F8FB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.StatisticsLover</item>
    </style>
</resources>
