<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StatisticsLover" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@color/shell_background</item>
        <item name="android:navigationBarColor">@color/shell_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="colorAccent">@color/splash_spinner</item>
    </style>

    <style name="Theme.StatisticsLover.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.StatisticsLover</item>
    </style>
</resources>
