# Public browser-safe configuration only. Never put service-role, database, or private keys in VITE_* variables.
VITE_APP_ENV=development
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Provider selections are application configuration, not hard-coded feature logic.
VITE_LIVE_PROVIDER=google_meet
VITE_VIDEO_PROVIDER=google_drive
